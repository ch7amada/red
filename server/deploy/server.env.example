# /etc/linux-monitor/server.env (root:linux-monitor, mode 0640)
# Use HOST=0.0.0.0 to allow trusted LAN and Tailscale access via your firewall rules.
HOST=100.x.y.z
PORT=8000
DATABASE_PATH=/var/lib/linux-monitor/linux-monitor.db
READER_TOKEN=<at least 32 characters>
ADMIN_TOKEN=<at least 32 characters, distinct from READER_TOKEN>
ENVIRONMENT=production
DOCS_ENABLED=false
# LLAMA_CPP_URL defaults to http://127.0.0.1:8081
# LLAMA_CPP_API_KEY= (required only if upstream is protected)
